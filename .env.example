# ─── AI Project Planner – Environment Configuration ────────────────────────
# Copy this file to `.env` and fill in at least one LLM API key.
# The application will use OpenAI if both keys are present.

# OpenAI (preferred)
OPENAI_API_KEY=sk-...your-key-here...

# Anthropic (fallback)
# ANTHROPIC_API_KEY=sk-ant-...your-key-here...
